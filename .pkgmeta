package-as: BPGP

# All libraries are vendored in BPGP/Libs, so there are no externals.
# Full release setup (embedded-libraries etc.): docs/release-plan-v1.md, section 10.4.

ignore:
  - scripts
  - docs
  - assets
  - CLAUDE.md
  - DEVELOPMENT-GUIDELINES.md
  - ARCHITECTURE.md
  - BPGP/_annotations

# The addon lives in a subfolder of the repository; ship only that folder.
move-folders:
  BPGP/BPGP: BPGP

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
