package-as: BP_EPGP

# All libraries are vendored in BP_EPGP/Libs, so there are no externals.
# Full release setup (embedded-libraries etc.): docs/release-plan-v1.md, section 10.4.

ignore:
  - scripts
  - docs
  - assets
  - CLAUDE.md
  - DEVELOPMENT-GUIDELINES.md
  - ARCHITECTURE.md
  - BP_EPGP/_annotations

# The addon lives in a subfolder of the repository; ship only that folder.
move-folders:
  BP_EPGP/BP_EPGP: BP_EPGP

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
