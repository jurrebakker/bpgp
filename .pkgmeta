package-as: BPGP

# All libraries are vendored in BPGP/Libs, so there are no externals.
# Release setup: DEVELOPMENT-GUIDELINES.md section 12 and docs/curseforge.md.

ignore:
  - scripts
  - docs
  - assets
  - CLAUDE.md
  - DEVELOPMENT-GUIDELINES.md
  - ARCHITECTURE.md
  - BPGP/_annotations

# The addon lives in a subfolder of the repository; ship only that folder.
move-folders:
  BPGP/BPGP: BPGP

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
